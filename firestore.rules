rules_version = '2';

// Gestão Rural — regras restritivas por fazenda.
// Todo dado de negócio vive em farms/{farmId}/... e só é acessível a quem tem
// um documento em farms/{farmId}/members/{uid}. Papéis: owner, admin, viewer.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberPath(f) { return /databases/$(database)/documents/farms/$(f)/members/$(request.auth.uid); }
    function isMember(f) { return signedIn() && exists(memberPath(f)); }
    function role(f) { return get(memberPath(f)).data.role; }
    function canEdit(f) { return isMember(f) && role(f) in ['owner', 'admin']; }
    function isOwner(f) { return isMember(f) && role(f) == 'owner'; }

    function d() { return request.resource.data; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(m, k, max) { return !(k in m) || m[k] == null || str(m[k], 0, max); }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optDate(m, k) { return !(k in m) || m[k] == null || isDate(m[k]); }
    // Valores em centavos (inteiro), até R$ 1 bilhão.
    function money(v) { return v is int && v >= 0 && v <= 100000000000; }
    function optMoney(m, k) { return !(k in m) || m[k] == null || money(m[k]); }
    function unchanged(k) { return request.resource.data[k] == resource.data[k]; }

    // Usuário só lê/escreve o próprio perfil.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && (request.method == 'delete' || d().keys().hasOnly(['name', 'email', 'updatedAt']));
    }

    // Consultas collectionGroup para descobrir fazendas do usuário e convites.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/invites/{inviteId} {
      allow read: if signedIn() && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email;
    }

    match /farms/{farmId} {
      function validFarm() {
        return d().keys().hasOnly(['name', 'ownerUid', 'ownerName', 'ownerPhone', 'ownerDocument', 'logoUrl', 'alertDays', 'arroba', 'createdAt', 'updatedAt'])
          && str(d().name, 1, 100)
          && optStr(d(), 'ownerName', 120) && optStr(d(), 'ownerPhone', 30) && optStr(d(), 'ownerDocument', 30)
          && optStr(d(), 'logoUrl', 500000)
          && d().alertDays is list && d().alertDays.size() <= 8
          && (!('arroba' in d()) || d().arroba is map);
      }
      allow read: if isMember(farmId);
      allow create: if signedIn() && d().ownerUid == request.auth.uid && validFarm();
      allow update: if canEdit(farmId) && unchanged('ownerUid') && validFarm();
      allow delete: if false;

      match /members/{uid} {
        function validMember() {
          return d().keys().hasOnly(['uid', 'email', 'name', 'role', 'joinedAt'])
            && d().uid == uid && d().role in ['owner', 'admin', 'viewer'];
        }
        function invitePath() {
          return /databases/$(database)/documents/farms/$(farmId)/invites/$(request.auth.token.email);
        }
        allow read: if isMember(farmId) || (signedIn() && uid == request.auth.uid);
        allow create: if signedIn() && uid == request.auth.uid && validMember() && (
          // Criador da fazenda vira owner (farm pode estar no mesmo lote).
          (d().role == 'owner' && getAfter(/databases/$(database)/documents/farms/$(farmId)).data.ownerUid == request.auth.uid)
          // Aceite de convite: e-mail verificado e papel igual ao convidado.
          || (d().role != 'owner' && request.auth.token.email_verified == true
              && d().email == request.auth.token.email
              && exists(invitePath()) && get(invitePath()).data.role == d().role)
        );
        allow update: if isOwner(farmId) && uid != request.auth.uid && validMember()
          && d().role in ['admin', 'viewer']
          && d().diff(resource.data).affectedKeys().hasOnly(['role']);
        allow delete: if (isOwner(farmId) && uid != request.auth.uid)
          || (signedIn() && uid == request.auth.uid && resource.data.role != 'owner');
      }

      match /invites/{email} {
        allow read: if canEdit(farmId);
        allow create, update: if canEdit(farmId)
          && d().keys().hasOnly(['email', 'role', 'farmName', 'invitedBy', 'createdAt'])
          && d().email == email && d().role in ['admin', 'viewer'];
        allow delete: if canEdit(farmId)
          || (signedIn() && request.auth.token.email == email && exists(memberPath(farmId)));
      }

      match /laborTypes/{id} {
        allow read: if isMember(farmId);
        allow create, update: if canEdit(farmId)
          && d().keys().hasOnly(['name', 'active', 'createdAt'])
          && str(d().name, 1, 60) && d().active is bool;
        allow delete: if false;
      }

      match /expenseCategories/{id} {
        allow read: if isMember(farmId);
        allow create, update: if canEdit(farmId)
          && d().keys().hasOnly(['name', 'active', 'createdAt'])
          && str(d().name, 1, 60) && d().active is bool;
        allow delete: if false;
      }

      match /collaborators/{id} {
        allow read: if isMember(farmId);
        allow create, update: if canEdit(farmId)
          && d().keys().hasOnly(['name', 'laborTypeId', 'phone', 'cpf', 'admissionDate', 'bond', 'referenceAmount', 'notes', 'active', 'createdAt', 'updatedAt'])
          && str(d().name, 2, 120) && str(d().laborTypeId, 1, 64)
          && d().bond in ['clt', 'diarista', 'autonomo', 'outro']
          && d().active is bool
          && optStr(d(), 'phone', 30) && optStr(d(), 'cpf', 14) && optStr(d(), 'notes', 1000)
          && optDate(d(), 'admissionDate') && optMoney(d(), 'referenceAmount');
        allow delete: if false; // Inativar preserva o histórico.
      }

      // Lote = registro imutável de uma operação de salvamento da planilha.
      match /expenseBatches/{id} {
        allow read: if isMember(farmId);
        allow create: if canEdit(farmId)
          && d().keys().hasOnly(['createdBy', 'createdAt', 'laborTotal', 'otherTotal', 'total', 'count'])
          && d().createdBy == request.auth.uid && d().createdAt == request.time
          && money(d().laborTotal) && money(d().otherTotal) && money(d().total)
          && d().count is int && d().count > 0 && d().count <= 450;
        allow update, delete: if false;
      }

      match /expenseEntries/{id} {
        function validEntry() {
          return d().keys().hasOnly(['kind', 'date', 'amount', 'laborTypeId', 'laborTypeName', 'collaboratorId', 'collaboratorName',
                                     'categoryId', 'categoryName', 'description', 'note', 'batchId', 'obligationId', 'createdBy', 'createdAt', 'updatedAt'])
            && d().kind in ['labor', 'other'] && isDate(d().date)
            && money(d().amount) && d().amount > 0
            && optStr(d(), 'description', 300) && optStr(d(), 'note', 300)
            && (d().kind == 'labor'
                  ? (str(d().collaboratorId, 1, 64) && str(d().collaboratorName, 1, 120) && str(d().laborTypeId, 1, 64))
                  : (str(d().categoryId, 1, 64) && str(d().categoryName, 1, 60)));
        }
        allow read: if isMember(farmId);
        allow create: if canEdit(farmId) && validEntry() && d().createdBy == request.auth.uid;
        allow update: if canEdit(farmId) && validEntry() && unchanged('createdBy') && unchanged('kind');
        allow delete: if canEdit(farmId);
      }

      match /obligations/{id} {
        allow read: if isMember(farmId);
        allow create, update: if canEdit(farmId)
          && d().keys().hasOnly(['type', 'title', 'collaboratorId', 'collaboratorName', 'referencePeriod', 'dueDate', 'paidDate',
                                 'amount', 'note', 'status', 'recurrence', 'nextId', 'createdAt', 'updatedAt'])
          && d().type in ['ferias', 'adiantamento_ferias', 'terco_ferias', 'decimo_1', 'decimo_2', 'outro']
          && str(d().collaboratorId, 1, 64) && str(d().collaboratorName, 1, 120)
          && isDate(d().dueDate) && optDate(d(), 'paidDate') && optMoney(d(), 'amount')
          && d().status in ['pendente', 'pago'] && d().recurrence in ['none', 'yearly']
          && (d().status == 'pendente' || isDate(d().paidDate))
          && optStr(d(), 'title', 100) && optStr(d(), 'note', 500) && optStr(d(), 'referencePeriod', 20);
        allow delete: if canEdit(farmId);
      }

      // Receitas (vendas de animais e outras entradas). Id determinístico evita duplicidade.
      match /revenueEntries/{id} {
        function validRevenue() {
          return d().keys().hasOnly(['date', 'amount', 'source', 'description', 'saleId', 'note', 'createdBy', 'createdAt', 'updatedAt'])
            && isDate(d().date) && money(d().amount) && d().amount > 0
            && d().source in ['venda_animais', 'outra']
            && str(d().description, 1, 300) && optStr(d(), 'note', 300) && optStr(d(), 'saleId', 64);
        }
        allow read: if isMember(farmId);
        allow create: if canEdit(farmId) && validRevenue() && d().createdBy == request.auth.uid;
        allow update: if canEdit(farmId) && validRevenue() && unchanged('createdBy') && unchanged('source');
        allow delete: if canEdit(farmId);
      }

      // ======================= REBANHO =======================
      match /animalCategories/{id} {
        allow read: if isMember(farmId);
        allow create, update: if canEdit(farmId)
          && d().keys().hasOnly(['name', 'active', 'createdAt'])
          && str(d().name, 1, 60) && d().active is bool;
        allow delete: if false;
      }

      // Ledger: movimentações imutáveis. Cada uma precisa do lote apontando para ela
      // (lastMovementId) no mesmo envio — e vice-versa (regra do lote abaixo).
      match /herdMovements/{movId} {
        allow read: if isMember(farmId);
        allow create: if canEdit(farmId)
          && d().keys().hasOnly(['type', 'date', 'lotId', 'keys', 'key1', 'qty1', 'key2', 'qty2', 'total', 'animalIds', 'refType', 'refId',
                                 'transferId', 'otherLotId', 'otherFarmId', 'note', 'createdBy', 'createdAt'])
          && d().createdBy == request.auth.uid
          && d().type in ['inicial', 'compra', 'nascimento', 'venda', 'morte', 'transf_saida', 'transf_entrada', 'ajuste', 'troca_categoria', 'estorno']
          && isDate(d().date) && str(d().lotId, 1, 64)
          && str(d().key1, 3, 140) && d().qty1 is int && d().qty1 != 0
          && d().total is int
          && (('key2' in d())
                ? (str(d().key2, 3, 140) && d().qty2 is int && d().keys == [d().key1, d().key2] && d().total == d().qty1 + d().qty2)
                : (d().keys == [d().key1] && d().total == d().qty1))
          && (!('animalIds' in d()) || (d().animalIds is list && d().animalIds.size() <= 450))
          && getAfter(/databases/$(database)/documents/farms/$(farmId)/herdLots/$(d().lotId)).data.lastMovementId == movId;
        allow update, delete: if false;
      }

      match /herdLots/{lotId} {
        function mv() { return getAfter(/databases/$(database)/documents/farms/$(farmId)/herdMovements/$(d().lastMovementId)).data; }
        function validLotMeta() {
          return d().keys().hasOnly(['name', 'code', 'categoryId', 'sex', 'formedAt', 'origin', 'sellerName', 'buyerName', 'notes', 'active',
                                     'count', 'balances', 'lastMovementId', 'avgWeightKg', 'avgWeightAt', 'createdAt', 'updatedAt'])
            && str(d().name, 1, 80) && d().sex in ['M', 'F', 'X'] && d().active is bool
            && d().count is int && d().count >= 0 && d().balances is map
            && optStr(d(), 'notes', 1000) && optStr(d(), 'sellerName', 120) && optStr(d(), 'buyerName', 120)
            && (!('avgWeightKg' in d()) || d().avgWeightKg == null || (d().avgWeightKg is number && d().avgWeightKg >= 0 && d().avgWeightKg < 3000));
        }
        // Saldo novo = saldo anterior + movimentação criada no mesmo envio; nunca negativo.
        function keyOk(m, k, q, prev) { return d().balances[k] is int && d().balances[k] == prev.get(k, 0) + q && d().balances[k] >= 0; }
        function balanceChangeOk(prevCount, prev) {
          return existsAfter(/databases/$(database)/documents/farms/$(farmId)/herdMovements/$(d().lastMovementId))
            && mv().lotId == lotId
            && d().count == prevCount + mv().total
            && d().balances.diff(prev).affectedKeys().hasOnly(mv().keys)
            && keyOk(mv(), mv().key1, mv().qty1, prev)
            && (!('key2' in mv()) || keyOk(mv(), mv().key2, mv().qty2, prev));
        }
        allow read: if isMember(farmId);
        allow create: if canEdit(farmId) && validLotMeta() && (
          ('lastMovementId' in d()) ? balanceChangeOk(0, {}) : (d().count == 0 && d().balances.size() == 0)
        );
        allow update: if canEdit(farmId) && validLotMeta() && (
          !d().diff(resource.data).affectedKeys().hasAny(['count', 'balances', 'lastMovementId'])
          || (d().lastMovementId != resource.data.get('lastMovementId', '') && balanceChangeOk(resource.data.count, resource.data.balances))
        );
        allow delete: if false;
      }

      match /animals/{id} {
        function validAnimal() {
          return d().keys().hasOnly(['tag', 'name', 'sex', 'categoryId', 'breed', 'birthDate', 'weightKg', 'lotId', 'entryDate', 'origin',
                                     'sellerName', 'buyerName', 'acquisitionCost', 'notes', 'status', 'lastWeighing', 'purchaseId', 'exitRef',
                                     'transferRef', 'reversalRef', 'createdBy', 'createdAt', 'updatedAt'])
            && str(d().tag, 1, 40) && d().sex in ['M', 'F'] && str(d().categoryId, 1, 64) && str(d().lotId, 1, 64)
            && isDate(d().entryDate) && d().origin in ['nascimento', 'compra', 'transferencia', 'existente']
            && d().status in ['ativo', 'vendido', 'morto', 'transferido', 'estornado']
            && optDate(d(), 'birthDate') && optMoney(d(), 'acquisitionCost') && optStr(d(), 'notes', 1000)
            && (!('weightKg' in d()) || d().weightKg == null || (d().weightKg is number && d().weightKg > 0 && d().weightKg < 3000));
        }
        allow read: if isMember(farmId);
        allow create: if canEdit(farmId) && validAnimal() && d().status == 'ativo';
        // Animal que saiu (vendido/morto/transferido) não volta a ficar ativo por edição.
        allow update: if canEdit(farmId) && validAnimal()
          && (resource.data.status == 'ativo' || d().status == resource.data.status
              // Estorno de venda/morte/transferência devolve o animal ao rebanho, vinculado ao registro de estorno.
              || (d().status == 'ativo' && ('reversalRef' in d()) && d().reversalRef != resource.data.get('reversalRef', '')
                  && existsAfter(/databases/$(database)/documents/farms/$(farmId)/reversals/$(d().reversalRef))));
        allow delete: if false;
      }

      // Registros de operações: somente inserção (correções geram novas operações/ajustes).
      match /{opCol}/{opId} {
        allow read: if isMember(farmId) && opCol in ['purchases', 'sales', 'births', 'mortalityRecords', 'herdTransfers', 'categoryChanges',
                                                     'inventoryAdjustments', 'herdInventories', 'vaccinations', 'weighingSessions', 'weighings', 'reversals'];
        allow create: if canEdit(farmId)
          && opCol in ['purchases', 'sales', 'births', 'mortalityRecords', 'herdTransfers', 'categoryChanges', 'inventoryAdjustments',
                       'herdInventories', 'vaccinations', 'weighingSessions', 'weighings', 'reversals']
          && d().createdBy == request.auth.uid && d().size() <= 60;
        // Exceções controladas: status da conferência física, baixa de reforço vacinal e marcação de correção de pesagem.
        allow update: if canEdit(farmId) && (
          (opCol == 'herdInventories' && d().diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']))
          || (opCol == 'vaccinations' && d().diff(resource.data).affectedKeys().hasOnly(['boosterDoneById', 'updatedAt']))
          || (opCol == 'weighings' && d().diff(resource.data).affectedKeys().hasOnly(['supersededBy', 'updatedAt']))
          // Estorno: marca a operação original (uma única vez) e exige o registro de estorno no mesmo envio.
          || (opCol in ['purchases', 'sales', 'births', 'mortalityRecords', 'herdTransfers', 'categoryChanges']
              && !('reversedBy' in resource.data)
              && d().diff(resource.data).affectedKeys().hasOnly(['reversedBy', 'reversedAt', 'revenueEntryId'])
              && (!('reversedBy' in d()) || existsAfter(/databases/$(database)/documents/farms/$(farmId)/reversals/$(d().reversedBy))))
        );
        allow delete: if false;
      }

      // Log de auditoria: só inserção, sem edição nem exclusão.
      match /logs/{id} {
        allow read: if canEdit(farmId);
        allow create: if isMember(farmId)
          && d().keys().hasOnly(['action', 'detail', 'uid', 'at'])
          && d().uid == request.auth.uid && d().at == request.time && str(d().action, 1, 60);
        allow update, delete: if false;
      }
    }
  }
}
