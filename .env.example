# Configuração web do Firebase (Console > Configurações do projeto > Seus apps).
# Estes valores são públicos por design; a proteção dos dados vem das Firestore Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional: "true" para usar os emuladores locais (npm run dev + firebase emulators:start)
VITE_USE_EMULATORS=false
